modules = ["web", "python-base-3.13", "nodejs-22", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cargo", "cups", "dbus", "freetype", "glib", "gtk3", "lcms2", "libdrm", "libgbm", "libglvnd", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libxkbcommon", "mesa", "nspr", "nss", "openjpeg", "openssl", "pango", "pkg-config", "postgresql", "rustc", "tcl", "tk", "util-linux", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libxcb", "xorg.libxkbfile", "zlib"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DJANGO_ALLOWED_HOSTS = "*"
DJANGO_DEBUG = "true"
CSRF_TRUSTED_ORIGINS = "https://animate.creatrweb.com,https://creatrweb.replit.app"
RUN_MIGRATIONS_ON_START = "true"

[userenv.production]
DJANGO_ALLOWED_HOSTS = "animate.creatrweb.com,creatrweb.replit.app,localhost,127.0.0.1"
DJANGO_DEBUG = "false"
RUN_MIGRATIONS_ON_START = "false"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "scripts/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
# Issue #133: scripts/start-production.sh sets FRONTEND_SERVE_MODE=preview
# so the deployed process serves the frontend build this section's own
# `build` command already produces (`npm run build` -> frontend/dist/) via
# `vite preview`, instead of running Vite's dev server with a live HMR
# WebSocket in production -- see scripts/start.sh's own comment for why
# that caused unexpected reloads. The interactive Replit workflow
# ([workflows.workflow] above) is unaffected: it still runs
# scripts/start.sh directly, defaulting to "dev" mode.
run = ["bash", "scripts/start-production.sh"]
build = ["bash", "-c", "cd backend && uv sync --locked && uv run python manage.py check --deploy && cd .. && npm --prefix frontend ci && npm --prefix frontend run build"]
