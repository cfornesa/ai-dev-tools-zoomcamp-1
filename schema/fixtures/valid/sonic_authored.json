{
  "schemaVersion": 1,
  "id": "scene-sonic-authored",
  "canvas": { "width": 800, "height": 600, "backgroundColor": "#ffffff" },
  "renderer": { "preferred": "p5" },
  "layers": [],
  "shapes": [],
  "groups": [],
  "bindings": [],
  "graph": { "nodes": [], "connections": [] },
  "accessibility": { "reducedMotion": "auto" },
  "randomness": { "seed": 0, "enabled": false },
  "sonic": {
    "tempo": 120,
    "root": "D",
    "scale": "dorian",
    "keyboard_scale": "minor",
    "transpose": 3,
    "instrument": "synth",
    "feel": "serene fixture",
    "extras": {
      "default_volume": 80,
      "voices": {
        "ambient": "synth",
        "movement": "amsynth",
        "melodic": "fmsynth"
      },
      "synth": {
        "oscillator": "square",
        "filter_type": "highpass",
        "filter_cutoff": 1800,
        "filter_resonance": 1.2,
        "octave_min": 2,
        "octave_max": 5,
        "envelope": {
          "attack": 0.02,
          "decay": 0.2,
          "sustain": 0.6,
          "release": 0.4
        },
        "effects": { "chorus": 0.1, "pitch_shift": 2 }
      }
    }
  }
