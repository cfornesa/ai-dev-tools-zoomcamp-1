# Copy this file to `.env` in the repo root and fill in real values for
# local development:
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Only this example file
# is tracked. None of the values below are real credentials.
#
# Load `.env` into the environment when running backend commands with:
#
#   uv run --env-file .env python manage.py <command>
#
# See AGENTS.md for the full copyable command list (install, DB setup,
# migrations, running the servers).

# --- Django core (required) ---

# Django's cryptographic signing key. Generate a real one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key

# --- Django core (optional; sane defaults are used if unset) ---

# "True" or "False". Default: False. Never enable in a real deployment.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames. Default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (required) ---
#
# A single connection URL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Validated when Django settings load, so the app fails fast with a clear
# error if it's unset or malformed. In Replit-deployed environments this
# is supplied automatically by Replit's managed PostgreSQL integration —
# development and production Repls each get their own DATABASE_URL, kept
# separate; never copy a production DATABASE_URL into a development .env
# or vice versa. For local development outside Replit, point this at
# your own PostgreSQL server.
DATABASE_URL=postgres://gesture_studio:changeme@localhost:5432/gesture_studio

# --- PostgreSQL (optional; used only by `uv run pytest`) ---
#
# Set this to opt a small number of tests (tests/test_health.py) into
# running against a real PostgreSQL server instead of the SQLite database
# the rest of the offline test suite uses. Point it at a disposable local
# or Replit-managed database — never at a production DATABASE_URL. Leave
# unset to skip those tests; the rest of the suite is unaffected either
# way.
POSTGRES_TEST_DATABASE_URL=postgres://gesture_studio_test:changeme@localhost:5432/gesture_studio_test

# --- Google OAuth (required) ---
#
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add every environment's callback URL
# as an Authorized redirect URI — e.g. https://YOUR-HOST/accounts/google/login/callback/
# — and its origin as an Authorized JavaScript origin. Only minimal identity
# scopes (openid, email, profile) are requested; no other Google API access
# is used. Development and production Google OAuth clients should be
# separate, the same way development and production DATABASE_URL are kept
# separate — never share or copy client secrets between environments.
#
# The values below are placeholders only, tracked by
# https://github.com/cfornesa/ai-dev-tools-zoomcamp-1/issues/75 for real
# credential provisioning; sign-in will not work against real Google
# accounts until real values replace them.
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme-generate-a-real-oauth-client-secret

# --- Signup reCAPTCHA v3 (optional in development; required when enabled in production) ---
#
# Set RECAPTCHA_ENABLED=True to protect local email/password signup. With
# protection disabled, development signup works without a token. In
# production, enabling it requires all four values below; the site key is
# public, but the secret must be stored only in Replit Secrets.
RECAPTCHA_ENABLED=False
RECAPTCHA_SITE_KEY=changeme-public-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=changeme-store-in-replit-secrets
RECAPTCHA_ACTION=signup
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# --- Personal Mistral credentials ---
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this deployment secret stable. Rotating it requires a planned
# re-encryption migration; it is never stored in the database or frontend.
MISTRAL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Optional during rotation only: a comma-separated list of previous Fernet
# roots keeps existing keys usable while saved credentials are re-encrypted.
MISTRAL_CREDENTIAL_PREVIOUS_ENCRYPTION_KEYS=
