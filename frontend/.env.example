# Copy this file to `.env` inside frontend/ for local development:
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. Only this example
# file is tracked. Vite loads `.env` automatically; only VITE_-prefixed
# variables are exposed to client-side code.

# Base URL of the Django backend API. Leave empty (the default) for local
# development: src/api/client.ts then uses relative paths ('/api/...'),
# which vite.config.ts's dev server proxies to Django on the same origin
# as the frontend, so the browser sees everything as same-origin (session
# cookie and CSRF work with no CORS/SameSite configuration needed). Only
# set this to an absolute URL for a genuinely cross-origin deployment
# (e.g. frontend and backend on different hosts) -- setting it locally
# makes every API call bypass the proxy and hit Django cross-origin,
# which breaks the session cookie.
VITE_API_BASE_URL=

# Task 214 (issue #246): set to 'true' to run the frontend entirely against
# an in-memory mock backend (src/services/mock/) instead of a real Django
# process -- no PostgreSQL, no `manage.py runserver`, and no network calls
# to /api/* or /accounts/logout/ at all (see src/mocks/installMockFetch.ts).
# Useful for frontend-only development/demoing. In mock mode, a fixed mock
# user is always treated as signed in -- there is no mock
# /accounts/login/, since that flow is server-rendered by Django and
# outside this app's control either way. Leave unset/'false' (the default)
# for normal development against the real backend.
VITE_USE_MOCK_BACKEND=
