modules = ["web", "postgresql-16", "python-base-3.13", "nodejs-22"]

[nix]
channel = "stable-25_05"
packages = ["util-linux", "glib", "nss", "nspr", "atk", "cups", "dbus", "gtk3", "pango", "cairo", "at-spi2-atk", "alsa-lib", "mesa", "libdrm", "xorg.libX11", "xorg.libxcb", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "libgbm", "libglvnd", "xorg.libXi", "xorg.libXrender", "xorg.libXtst", "libxkbcommon", "xorg.libxkbfile"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DJANGO_ALLOWED_HOSTS = "*"
DJANGO_DEBUG = "true"
CSRF_TRUSTED_ORIGINS = "https://animate.creatrweb.com,https://creatrweb.replit.app"

[userenv.production]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "scripts/start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/start.sh"]
build = ["bash", "-c", "uv sync --locked && npm --prefix frontend ci && npm --prefix frontend run build"]
