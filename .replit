modules = ["web", "postgresql-16", "python-base-3.13", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
DJANGO_ALLOWED_HOSTS = "*"
DJANGO_DEBUG = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'uv run python manage.py runserver 0.0.0.0:8000 & exec npm --prefix frontend run dev -- --host 0.0.0.0 --port 5000'"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
