{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gesture-reactive-studio/schema/scene3d.schema.json",
  "title": "Scene3D",
  "description": "Canonical, renderer-neutral 3D scene document. Per issue #208's decision, this is a genuinely separate document family from the 2D canonical scene (schema/scene.schema.json) -- not an extension of it, and never valid input to the 2D validators/renderers. `documentType: \"scene3d\"` is a required literal marker specifically so no code path that only checks `schemaVersion` (a plain integer both schemas happen to start at 1) can ever mistake a 3D document for a 2D one or vice versa. This schema enforces document *shape* (structure, types, enums, per-field value ranges); scene-wide complexity and payload-size limits (max object count, max light count, etc.) are enforced separately by validators against schema/limits3d.json, not by this file -- mirroring scene.schema.json's own split with schema/limits.json. See schema/README3d.md for the versioning policy and validation model, which mirrors schema/README.md's for the 2D schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "scene",
    "camera",
    "lights",
    "groups",
    "objects",
    "randomness"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Document format version. V1 validators only accept the value 1; any other value is an unsupported schema version and is rejected before any other validation runs.",
      "const": 1
    },
    "documentType": {
      "description": "Literal discriminator distinguishing this document family from the 2D canonical scene. Always \"scene3d\" for this schema.",
      "const": "scene3d"
    },
    "id": { "$ref": "#/$defs/id" },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backgroundColor"],
      "properties": {
        "backgroundColor": { "$ref": "#/$defs/color" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "fov", "near", "far"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "target": {
          "description": "The point the camera looks at (a look-at target, not a direction vector).",
          "$ref": "#/$defs/vec3"
        },
        "fov": {
          "description": "Vertical field of view, in degrees.",
          "type": "number",
          "minimum": 1,
          "maximum": 170
        },
        "near": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "far": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
      }
    },
    "lights": {
      "type": "array",
      "items": { "$ref": "#/$defs/light" }
    },
    "groups": {
      "description": "Optional hierarchical grouping of objects, mirroring the 2D schema's groups/groupId nesting convention for scene-outline organization. Purely structural -- carries its own transform, composed with each member object's own transform, exactly like the 2D schema's group transform.",
      "type": "array",
      "items": { "$ref": "#/$defs/group3d" }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object3d" }
    },
    "renderer": {
      "description": "Optional explicit rendering library for this scene (#770): `threejs` or `aframe`, the only two 3D engines. Additive and backward compatible: no schemaVersion bump, and a document without it resolves to `threejs` (the only 3D builder that existed before it), so no stored scene needs rewriting. Mirrors the 2D schema's `renderer.preferred`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred"],
      "properties": {
        "preferred": { "enum": ["threejs", "aframe"] }
      }
    },
    "sonic": { "$ref": "#/$defs/sonic" },
    "randomness": {
      "description": "Deterministic-randomness declaration, mirroring the 2D schema's identical field (Task 40) -- reserved for future seeded-placement/material-variation features; carries no effect on its own in this initial schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "enabled"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier for any object with identity in the scene (object, group, light).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "z": { "type": "number", "minimum": -100000, "maximum": 100000 }
      }
    },
    "eulerRotation": {
      "description": "Rotation in degrees around each axis (Euler angles, applied in a fixed X-then-Y-then-Z order by every renderer -- not a general-purpose rotation representation).",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -360, "maximum": 360 },
        "y": { "type": "number", "minimum": -360, "maximum": 360 },
        "z": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "scale3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000 },
        "z": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "transform3D": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation", "scale", "opacity"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/eulerRotation" },
        "scale": { "$ref": "#/$defs/scale3" },
        "opacity": { "$ref": "#/$defs/unitInterval" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "$ref": "#/$defs/unitInterval" },
        "emissive": {
          "description": "Optional self-illumination color; a renderer that doesn't support emissive materials treats this as absent.",
          "$ref": "#/$defs/color"
        }
      }
    },
    "group3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "transform", "visible", "locked"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "transform": { "$ref": "#/$defs/transform3D" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "color", "intensity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": {
          "description": "Optional user-facing display/addressing name, mirroring the 2D schema's shape.name (post-#214).",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": { "enum": ["directional", "point", "ambient"] },
        "color": { "$ref": "#/$defs/color" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 100 },
        "position": {
          "description": "Required for \"point\" lights; ignored for \"directional\"/\"ambient\".",
          "$ref": "#/$defs/vec3"
        },
        "direction": {
          "description": "Required for \"directional\" lights; ignored for \"point\"/\"ambient\".",
          "$ref": "#/$defs/vec3"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "point" } } },
          "then": { "required": ["position"] }
        },
        {
          "if": { "properties": { "type": { "const": "directional" } } },
          "then": { "required": ["direction"] }
        }
      ]
    },
    "baseObjectFields": {
      "type": "object",
      "required": ["id", "type", "groupId", "transform", "material", "visible"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": {
          "description": "Optional user-facing display/addressing name, mirroring the 2D schema's shape.name (post-#214). Declared once here (not per-type) since object3d's per-type branches use unevaluatedProperties composition, not per-branch additionalProperties allowlists -- see .agents/memory/scene-schema-allof-branch-property-shadowing.md for why that distinction matters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": { "enum": ["box", "sphere", "cylinder", "plane", "drawingPlane"] },
        "groupId": {
          "description": "The containing group's id, or null for a top-level object -- mirrors the 2D schema's identical groupId convention.",
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "transform": { "$ref": "#/$defs/transform3D" },
        "material": { "$ref": "#/$defs/material" },
        "visible": { "type": "boolean" },
        "animation": { "$ref": "#/$defs/objectAnimation" }
      }
    },
    "boxObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObjectFields" },
        {
          "type": "object",
          "required": ["width", "height", "depth"],
          "properties": {
            "type": { "const": "box" },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "depth": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sphereObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObjectFields" },
        {
          "type": "object",
          "required": ["radius"],
          "properties": {
            "type": { "const": "sphere" },
            "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "cylinderObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObjectFields" },
        {
          "type": "object",
          "required": ["radiusTop", "radiusBottom", "height"],
          "properties": {
            "type": { "const": "cylinder" },
            "radiusTop": { "type": "number", "minimum": 0, "maximum": 5000 },
            "radiusBottom": { "type": "number", "minimum": 0, "maximum": 5000 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "planeObject": {
      "allOf": [
        { "$ref": "#/$defs/baseObjectFields" },
        {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "type": { "const": "plane" },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "objectAnimation": {
      "description": "Optional declarative animation for a scene object (#783): one of four closed kinds, rendered identically by Three.js and A-Frame, paused by reduced-motion and by draw mode. `rotate` spins about `axis` at `speed` degrees per second; `orbit` circles the object about `center` (default the origin) around `axis` at `speed` degrees per second; `oscillate` slides along `axis` by `amplitude` world units at `speed` cycles per second; `pulse` scales uniformly by 1 +/- `amplitude` at `speed` cycles per second. Additive and optional, so no schemaVersion bump.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "speed"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rotate",
            "orbit",
            "oscillate",
            "pulse"
          ]
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "center": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "drawingShape": {
      "description": "One vector shape inside a drawingPlane's drawing (#778), in the drawing's own pixel coordinate space (origin top-left, y down). Closed vocabulary: rect, ellipse, line, path. Fill and stroke are colours or null; opacity is a unit interval.",
      "oneOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "type",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "rect"
                },
                "x": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "fill": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stroke": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strokeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 256
                },
                "opacity": {
                  "$ref": "#/$defs/unitInterval"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "type",
                "cx",
                "cy",
                "rx",
                "ry"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "ellipse"
                },
                "cx": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "cy": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "rx": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "ry": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "fill": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stroke": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strokeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 256
                },
                "opacity": {
                  "$ref": "#/$defs/unitInterval"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "type",
                "x1",
                "y1",
                "x2",
                "y2"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "line"
                },
                "x1": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y1": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "x2": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                },
                "y2": {
                  "type": "number",
                  "minimum": -100000,
                  "maximum": 100000
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "fill": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stroke": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strokeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 256
                },
                "opacity": {
                  "$ref": "#/$defs/unitInterval"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "type",
                "points",
                "closed"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "path"
                },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  }
                },
                "closed": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "fill": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stroke": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/color"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strokeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 256
                },
                "opacity": {
                  "$ref": "#/$defs/unitInterval"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "drawingDocument": {
      "description": "The 2D vector drawing carried by a drawingPlane (#778): a pixel-space canvas (width x height), an optional background colour (null = transparent), and an ordered list of shapes drawn bottom to top. Per-plane shape and point counts are capped by schema/limits3d.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "shapes"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawingShape"
          }
        }
      }
    },
    "drawingPlaneObject": {
      "description": "A flat plane asset in the 3D scene that displays a 2D vector drawing (#778). It is a normal scene object: the standard transform, visibility, group, name, and material apply (the material colour tints the fallback surface used when a renderer cannot draw the vector content, for example a thumbnail). width/height are the plane's size in world units; the drawing is stretched over it.",
      "allOf": [
        {
          "$ref": "#/$defs/baseObjectFields"
        },
        {
          "type": "object",
          "required": [
            "width",
            "height",
            "drawing"
          ],
          "properties": {
            "type": {
              "const": "drawingPlane"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "doubleSided": {
              "type": "boolean"
            },
            "drawing": {
              "$ref": "#/$defs/drawingDocument"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "object3d": {
      "oneOf": [
        { "$ref": "#/$defs/boxObject" },
        { "$ref": "#/$defs/sphereObject" },
        { "$ref": "#/$defs/cylinderObject" },
        { "$ref": "#/$defs/planeObject" },
        { "$ref": "#/$defs/drawingPlaneObject" }
      ]
    },
    "sonic": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tempo": { "type": "integer", "minimum": 40, "maximum": 220 },
        "root": { "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] },
        "scale": { "enum": ["major", "minor", "pentatonic", "chromatic", "dorian", "phrygian", "lydian", "mixolydian", "wholetone"] },
        "keyboard_scale": { "enum": ["major", "minor", "pentatonic", "chromatic", "dorian", "phrygian", "lydian", "mixolydian", "wholetone"] },
        "transpose": { "type": "integer", "minimum": -12, "maximum": 12 },
        "follow_key": { "type": "boolean" },
        "instrument": { "enum": ["synth", "amsynth", "fmsynth", "membranesynth", "metalsynth", "plucksynth", "duosynth"] },
        "feel": { "type": "string", "maxLength": 400 },
        "extras": { "$ref": "#/$defs/sonicExtras" }
      }
    },
    "sonicExtras": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default_volume": { "type": "number", "minimum": 0, "maximum": 100 },
        "ambient_volume": { "type": "number", "minimum": 0, "maximum": 100 },
        "keyboard_volume": { "type": "number", "minimum": 0, "maximum": 100 },
        "ambient_sample": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!https?:|//)" },
        "voices": { "type": "object", "additionalProperties": false, "properties": {
          "ambient": { "enum": ["synth", "amsynth", "fmsynth", "membranesynth", "metalsynth", "plucksynth", "duosynth"] },
          "movement": { "enum": ["synth", "amsynth", "fmsynth", "membranesynth", "metalsynth", "plucksynth", "duosynth"] },
          "melodic": { "enum": ["synth", "amsynth", "fmsynth", "membranesynth", "metalsynth", "plucksynth", "duosynth"] }
        }},
        "synth": { "$ref": "#/$defs/sonicSynth" }
      }
    },
    "sonicSynth": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "oscillator": { "enum": ["sine", "square", "sawtooth", "triangle"] },
        "filter_type": { "enum": ["lowpass", "highpass", "bandpass"] },
        "filter_cutoff": { "type": "number", "minimum": 20, "maximum": 20000 },
        "filter_resonance": { "type": "number", "minimum": 0.1, "maximum": 20 },
        "octave_min": { "type": "integer", "minimum": -1, "maximum": 7 },
        "octave_max": { "type": "integer", "minimum": -1, "maximum": 7 },
        "envelope": { "$ref": "#/$defs/sonicEnvelope" },
        "effects": { "$ref": "#/$defs/sonicEffects" }
      }
    },
    "sonicEnvelope": {
      "type": "object", "additionalProperties": false,
      "properties": {
